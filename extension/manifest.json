{
  "manifest_version": 3,
  "name": "Atlas Browser Bridge",
  "version": "0.5.1",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Autorizar Atlas en esta pesta\u00f1a"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
