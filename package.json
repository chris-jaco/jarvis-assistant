{
  "name": "jarvis-assistant",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json && npm run build:extension",
    "start": "node --env-file-if-exists=.env dist/server/server/index.js",
    "test": "tsx --test src/core/*.test.ts src/server/*.test.ts src/tools/*.test.ts src/memory/*.test.ts src/client/*.test.ts",
    "google:authorize": "tsx src/server/google-authorize.ts",
    "gmail:authorize": "tsx src/server/gmail-authorize.ts",
    "gmail:accounts": "tsx src/server/gmail-accounts.ts",
    "memory:bootstrap": "tsx src/server/memory-bootstrap.ts",
    "build:extension": "node scripts/build-extension.mjs",
    "pretest": "npm run build:extension"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@openai/agents-core": "0.18.0",
    "@openai/agents-realtime": "^0.18.0",
    "google-auth-library": "11.1.0",
    "mailparser": "^3.9.34",
    "nodemailer": "^10.0.14",
    "playwright": "1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/jsdom": "21.1.7",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "jsdom": "26.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
