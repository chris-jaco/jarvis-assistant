{
  "name": "jarvis-assistant",
  "version": "0.6.1",
  "private": true,
  "description": "Atlas Desktop Companion",
  "main": "dist/desktop-build/desktop/main.js",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json && npm run build:extension",
    "desktop:build": "npm run build && tsc -p tsconfig.desktop.json && node scripts/build-desktop-preload.mjs",
    "desktop:package:win": "npm run desktop:build && electron-builder --win dir --publish never",
    "desktop:verify-package": "node scripts/verify-desktop-package.mjs release/win-unpacked",
    "desktop:dev": "npm run desktop:build && electron dist/desktop-build/desktop/main.js",
    "start": "node --env-file-if-exists=.env dist/server/server/index.js",
    "test": "tsx --test src/core/*.test.ts src/server/*.test.ts src/tools/*.test.ts src/memory/*.test.ts src/client/*.test.ts",
    "google:authorize": "tsx src/server/google-authorize.ts",
    "gmail:authorize": "tsx src/server/gmail-authorize.ts",
    "gmail:accounts": "tsx src/server/gmail-accounts.ts",
    "memory:bootstrap": "tsx src/server/memory-bootstrap.ts",
    "build:extension": "node scripts/build-extension.mjs",
    "pretest": "npm run build:extension",
    "desktop:installer:win": "npm run desktop:build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@openai/agents-core": "0.18.0",
    "@openai/agents-realtime": "^0.18.0",
    "google-auth-library": "11.1.0",
    "mailparser": "^3.9.34",
    "nodemailer": "^10.0.14",
    "playwright": "1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/jsdom": "21.1.7",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "electron": "44.7.2",
    "electron-builder": "26.0.12",
    "jsdom": "26.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "build": {
    "appId": "com.atlas.desktop",
    "productName": "Atlas",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/client/**/*",
      "dist/server/**/*",
      "dist/desktop-build/**/*",
      "dist/desktop-preload/**/*",
      "dist/desktop-credential-setup/**/*",
      "public/brand/**/*",
      "node_modules/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.test.*",
      "!**/.env*",
      "!**/.local/**",
      "!**/*google-tokens*.json",
      "!**/credentials.v1.json",
      "!**/journal.json"
    ],
    "win": {
      "icon": "public/brand/atlas-app.ico",
      "target": [
        "dir",
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atlas",
      "installerIcon": "public/brand/atlas-app.ico",
      "uninstallerIcon": "public/brand/atlas-app.ico",
      "installerHeaderIcon": "public/brand/atlas-app.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
