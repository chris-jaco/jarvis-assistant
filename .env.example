OPENAI_API_KEY=
PORT=3000
HOST=127.0.0.1
USER_TIMEZONE=Europe/Madrid
OPENAI_SEARCH_MODEL=gpt-4.1
TOOL_CONFIRM_WRITES=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/oauth/callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_TOKEN_PATH=.local/google-tokens.json
# Opt-in local confirmation diagnostics; ignored by the production server.
JARVIS_CONFIRMATION_TRACE=false

# Independent backend-only Gmail accounts; Calendar token path remains unchanged.
GMAIL_ACCOUNTS_PATH=.local/gmail-accounts

# Persistent local memory; all paths must remain inside ignored .local.
MEMORY_PATH=.local/memory/memories.json
MEMORY_CONTEXT_CHARS=3000
MEMORY_RETRIEVAL_LIMIT=5
MEMORY_AUTOMATIC=true

# Optional visible browser. Windows: msedge; macOS/Linux: chrome.
# chromium requires: npx playwright install chromium
BROWSER_ENABLED=false
BROWSER_CHANNEL=msedge
# Opt-in Browser Control metadata-only runtime/bridge diagnostics.
BROWSER_TRACE=false

# Browser attached acceptance (explicit opt-in; Windows native host installation required)
BROWSER_PROVIDER=isolated
ATLAS_BROWSER_HOST_PATH=
ATLAS_BROWSER_EXTENSION_ID=
# Set only when multiple Chrome connections exist (UUID from browser status)
BROWSER_CONNECTION_ID=

# Sanitized authorization-chain diagnostics only (disabled by default)
ATLAS_ACCESS_TRACE=false
